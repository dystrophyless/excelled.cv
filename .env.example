# Copy to .env and fill in. Never commit .env.

# PostgreSQL (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/novio

# Random string used to sign email codes, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me

# Resend (https://resend.com) — verification and password-reset emails
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# "development" lets the session cookie work over plain HTTP on localhost; leave unset in production
ENVIRONMENT=development

# Origin the web app is served from (state-changing requests must come from it)
FRONTEND_ORIGIN=http://localhost:5173

# Optional: session lifetime in days (default 30)
# SESSION_DAYS=30
